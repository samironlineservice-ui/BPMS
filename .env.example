# ── Lokal PostgreSQL (embedded) ──
PG_PORT=5544
PG_SUPERUSER_PASSWORD=postgres_dev_pw
APP_MIGRATOR_PASSWORD=migrator_dev_pw
APP_RW_PASSWORD=rw_dev_pw
APP_PORTAL_PASSWORD=portal_dev_pw
APP_READONLY_PASSWORD=readonly_dev_pw

DATABASE_URL_MIGRATOR=postgresql://app_migrator:migrator_dev_pw@127.0.0.1:5544/ads_erp
DATABASE_URL=postgresql://app_rw:rw_dev_pw@127.0.0.1:5544/ads_erp
DATABASE_URL_PORTAL=postgresql://app_portal:portal_dev_pw@127.0.0.1:5544/ads_erp
TEST_DATABASE_NAME=ads_erp_test

# ── Server ──
PORT=3100
APP_ORIGIN=http://localhost:5173
PORTAL_ORIGIN=http://localhost:5174
# To'lov tizimlari (Payme/Click/Uzum/Paynet) callback'lari uchun ommaviy API manzili. Lokal emulyatorga kerak emas;
# provayder sandbox'i uchun ommaviy HTTPS manzil bo'lishi shart (staging server yoki tunnel).
PUBLIC_API_URL=http://localhost:3100
SESSION_SECRET=change-me-dev-session-secret-32chars-min
ENCRYPTION_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
STORAGE_DIR=var/storage
TZ_COMPANY=Asia/Tashkent
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# Ikki bosqichli tasdiqlash: false — vaqtincha o'chirish, faqat lokal ishlash uchun (production'da har doim yoqiq)
# MFA_ENABLED=true
# Mijozlar kabinetda o'zi ro'yxatdan o'tishi (false — faqat taklif orqali)
# PORTAL_REGISTRATION=true

# ── Seed: birinchi rahbar akkaunti (faqat bazada yo'q bo'lsa yaratiladi) ──
# Berilmasa — lokal dev standarti (README). Production'da SEED_DIRECTOR_PASSWORD majburiy (kamida 12 belgi).
# SEED_DIRECTOR_EMAIL=rahbar@ads.local
# SEED_DIRECTOR_PASSWORD=

# ── Smoke test (npm test) ──
# SMOKE_PORT=3199

# ── Ixtiyoriy integratsiyalar ──
TELEGRAM_BOT_TOKEN=
SMTP_URL=
CBU_RATES_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/
